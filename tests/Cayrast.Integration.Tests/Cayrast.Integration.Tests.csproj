<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integration tests that exercise real Windows APIs.

    Separate from Cayrast.Core.Tests on purpose. Those are fast, deterministic, and run
    anywhere; these touch the shell, enumerate the machine's installed software, and
    depend on what is actually on the box. Mixing the two would make a fast unit suite
    slow and machine-dependent, and would tempt people to skip the whole thing.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Cayrast.Integration.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cayrast.Core\Cayrast.Core.csproj" />
    <ProjectReference Include="..\..\src\Cayrast.Platform.Windows\Cayrast.Platform.Windows.csproj" />

    <!--
      Referenced so Cayrast.Sdk is present in this test host's default load context,
      mirroring the real shell. ModuleLoadContext deliberately resolves the SDK from
      the host rather than the module directory, so a host without it cannot load any
      module that uses the SDK.
    -->
    <ProjectReference Include="..\..\src\Cayrast.Sdk\Cayrast.Sdk.csproj" />

    <!--
      Ensures the example module is built before these tests run, so the lifecycle test
      has a real package to pack. ReferenceOutputAssembly is false because the test
      must load it dynamically, exactly as the host would, rather than linking it.
    -->
    <ProjectReference Include="..\..\modules\Cayrast.Modules.Example\Cayrast.Modules.Example.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

</Project>
