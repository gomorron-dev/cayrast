<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cayrast.Core — the engines.

    Search pipeline, command engine, settings registry, module registry and
    permission broker, theme resolution, storage.

    Core contains logic, not interop. Anything that P/Invokes or touches a
    Windows-only API belongs in Cayrast.Platform.Windows behind an interface
    declared here or in Abstractions. That boundary is what keeps Core testable.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Cayrast.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cayrast.Abstractions\Cayrast.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!--
    Microsoft.Data.Sqlite is deliberately NOT referenced yet. The frecency store is a
    few hundred key/value pairs read wholly into memory, which a JSON file handles
    without a schema, a migration story, or a native dependency. SQLite returns in
    Phase 3 for the clipboard, which genuinely needs indexed queries over blobs — its
    version and security pin are already recorded in Directory.Packages.props.
  -->

</Project>
